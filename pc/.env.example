# ============================================================
#  Конфигурация локального ИИ-агента. Скопируйте в .env
#  Все переменные читаются в core/settings.py (класс Settings).
# ============================================================

# --- LLM (обязательно) ---
# Ключ OpenAI-совместимого провайдера. Например, OpenRouter, GateYourWay или OpenAI.
LLM_API_KEY=

# Базовый URL OpenAI-совместимого API.
# OpenRouter: https://openrouter.ai/api/v1
# GateYourWay: https://api.gateyourway.com/v1
# Локальная Ollama: http://localhost:11434/v1
# LM Studio:        http://localhost:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию (можно переопределить из UI)
DEFAULT_MODEL=anthropic/claude-sonnet-4.5

# Температура и лимит токенов ответа (пусто = решает провайдер)
LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096

# Потолок токенов на ОДНУ задачу (сумма по всем шагам). При достижении
# агент завершает работу итоговым ответом, не тратя бюджет дальше. 0 — без лимита.
MAX_RUN_TOKENS=0

# Таймаут одного запроса к LLM (сек) и число повторов при сетевых ошибках
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# Reasoning level: adaptive (low, high after a failing test) | low | medium | high | default
LLM_REASONING=adaptive
# How the provider takes it: auto | openrouter | openai | zai | none
LLM_REASONING_DIALECT=auto
# Seconds to wait for the first byte of an answer (a flowing stream is never cut)
LLM_FIRST_BYTE_TIMEOUT=90
# Backup models, comma-separated (each uses its own key from the model list)
LLM_FALLBACK_MODELS=
# A provider slower than this (first byte, s) twice in a row is skipped for LLM_BREAKER_MINUTES
LLM_SLOW_FIRST_BYTE=40
LLM_BREAKER_MINUTES=10
# Requests in flight per provider (0 = adapt when the provider refuses for concurrency)
LLM_MAX_CONCURRENT=0

# Предохранитель от зацикливания: reasoning-модель иногда генерирует один и тот
# же текст без конца (read-timeout при этом молчит — поток-то идёт). Если длина
# ответа превысит лимит, поток обрывается. Значение выше любого нормального ответа.
LLM_STREAM_CHAR_LIMIT=160000

# --- Директории ---
# Папка приложения: логи, сохранённые чаты, навыки, mcp_servers.json.
# Меняйте, только если хотите держать данные агента отдельно от кода.
# APP_PATH=D:\AI_Agent

# --- Рабочая директория ---
# Всё, что агент читает/пишет, ограничено этой папкой (если не разрешено иное).
# Пусто — «Документы» пользователя; в самом приложении папка выбирается для каждого чата.
# WORKSPACE_PATH=C:\Users\you\Projects

# Разрешить инструментам выходить за пределы WORKSPACE (опасно!)
ALLOW_OUTSIDE_WORKSPACE=false

# Дополнительные разрешённые корни (через ';'), например: D:\Projects;C:\Temp
EXTRA_ALLOWED_ROOTS=

# --- Поведение агента ---
# Максимум шагов (итераций "модель -> инструменты") в одной задаче. 0 — без лимита
MAX_STEPS=0
# Максимум одновременно выполняемых инструментов
MAX_PARALLEL_TOOLS=5
# На каком одинаковом вызове инструмента остановить возможное зацикливание
REPEAT_CALL_BLOCK_LIMIT=20
# Примерный бюджет контекста в токенах (история обрезается при превышении)
CONTEXT_TOKEN_BUDGET=120000
# Сворачивать старую часть длинного диалога в резюме (true) или просто
# выбрасывать (false). Резюме стоит одного дешёвого вызова модели.
CONTEXT_COMPACTION=true
# Очищать старые выводы инструментов (кроме последних N), когда история перевалила
# за половину бюджета. Дешевле резюме и почти не влияет на качество.
TOOL_RESULT_CLEARING=true
TOOL_RESULT_KEEP_RECENT=8
# Отправлять модели только основные инструменты, остальные — по запросу через
# tool_search. Экономит ~20 тыс. токенов на каждом запросе.
TOOL_SEARCH=true
# The model names a new chat from its first message (one tiny extra request to the cheapest
# configured model). false: the chat is named after the first line of that message.
CHAT_TITLES=true
# The packaged app puts the `altair` terminal command on your PATH when it starts (Windows: the
# user's Path, no admin rights; Linux/macOS: a link in ~/.local/bin). false: leave PATH alone.
CLI_ON_PATH=true
# After a browser action on the same page the agent gets only what changed, not the whole
# page again (cuts a browsing task's tokens roughly in half). false: always the whole page.
BROWSER_SNAPSHOT_DIFF=true
# Сколько символов результата инструмента отдаём модели (остальное обрезается)
TOOL_OUTPUT_LIMIT=12000
# Язык итоговых ответов агента
AGENT_LANGUAGE=русский

# --- Поиск в интернете (опционально: по умолчанию используется бесплатный DuckDuckGo) ---
# Tavily API: https://tavily.com (высокоточный поиск, оптимизированный для LLM)
# TAVILY_API_KEY=
# Brave Search API: https://brave.com/search/api/
# BRAVE_API_KEY=

# --- Безопасность ---
# Режим разрешений по умолчанию (в каждом чате переключается в интерфейсе):
#   manual       — спрашивать перед правкой файлов, командами и сетью
#   accept_edits — файлы правит сам; команды и сеть — с подтверждения
#   plan         — только изучает проект, изменения запрещены
#   allowlist    — работают лишь заранее разрешённые инструменты
#   bypass       — выполняет всё без вопросов (для песочницы)
# Старые значения auto/dangerous/all понимаются и переводятся автоматически.
APPROVAL_MODE=manual

# Таймаут ожидания подтверждения пользователя (сек). По истечении — отказ.
APPROVAL_TIMEOUT=180

# Таймаут выполнения shell-команд (сек)
SHELL_TIMEOUT=120

# --- Android UI-проверки (опционально) ---
# Корень Android SDK. Пусто — используется ANDROID_HOME/ANDROID_SDK_ROOT или PATH.
# ANDROID_SDK_PATH=C:\\Users\\you\\AppData\\Local\\Android\\Sdk
ANDROID_SDK_PATH=
# Имя AVD по умолчанию из Android Studio > Device Manager.
ANDROID_AVD_NAME=
# Таймаут команд adb и диагностики (сек).
ANDROID_TIMEOUT=120

# --- Обновления ---
# Источник обновлений. Пусто — релизы проекта на GitHub (github:Qweezyy/AltairAgent):
# обновление ставится само, только если подпись релиза совпала с ключом приложения.
# Можно указать свой JSON-манифест (ссылка или путь в общей папке) или off — не проверять.
#   UPDATE_URL=https://example.com/agent/update.json
#   UPDATE_URL=\\server\share\agent\update.json
#   UPDATE_URL=off
UPDATE_URL=

# --- Сервер ---
HOST=127.0.0.1
PORT=8000

# --- Логи ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Глубокое исследование
# RESEARCH_MODEL=            # пусто -> та же модель, что и основная
# RESEARCH_MAX_SOURCES=14
# RESEARCH_CONCURRENCY=4

# Built-in browser and VPN: auto = direct first, through the VPN only for sites that do not
# open directly; direct = always bypass the VPN; vpn = always through the VPN.
BROWSER_NETWORK=auto
