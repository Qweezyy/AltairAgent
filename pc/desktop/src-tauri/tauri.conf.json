{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Altair",
  "version": "../package.json",
  "identifier": "com.localaiagent.app",
  "build": {
    "frontendDist": "../../static",
    "devUrl": "http://localhost:8137"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
